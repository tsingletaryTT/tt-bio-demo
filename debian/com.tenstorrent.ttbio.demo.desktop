[Desktop Entry]
# FILENAME AND Icon= ARE BOTH THE APP ID, reverse-DNS on tenstorrent.com.
# That is the freedesktop convention for a globally unique application
# identity, and it is what the other Tenstorrent apps are converging on
# (tt-station already ships com.tenstorrent.ttstation.panel).
#
# com, not ai: tenstorrent.com is the identity of record -- the docs site and
# the maintainer address both live there. And NO HYPHENS in the components:
# a Flatpak app ID must be a valid D-Bus name, and D-Bus name elements cannot
# contain hyphens, so "tt-bio-demo" could never be one. The Debian PACKAGE is
# still called tt-bio-demo; a package name and an app ID are different things.
Type=Application
Name=tt-bio Protein Folding Demo
GenericName=Protein Structure Prediction
Comment=Watch a protein fold in real time on Tenstorrent Blackhole hardware
# run-demo.sh, not `venv-ui/bin/python3 -m ui.app`: the launcher starts the
# daemon too and tears it down on exit, which is what someone double-clicking
# an icon expects. It picks venv-ui for the UI half itself.
Exec=/opt/tt-bio-demo/scripts/run-demo.sh
Icon=com.tenstorrent.ttbio.demo
Terminal=false
# ONE main category, deliberately. Science, Development, Education, Utility
# and friends are the spec's registered MAIN categories, and each one is a
# section a desktop can file this under -- listing two makes the app appear
# twice in the menu, which desktop-file-validate warns about. Science is the
# right single home (it shows as "Science & Math" or "Education & Science"
# depending on the desktop); Biology is an ADDITIONAL category, which refines
# placement without creating a second one.
#
# A vendor "Tenstorrent" section was built and then deliberately withdrawn --
# see docs/followups.md. It needs an X- prefixed category plus a .directory
# and an XDG .menu merge, and those last two must be owned by a package shared
# with the other Tenstorrent apps rather than by this one.
Categories=Science;Biology;
Keywords=protein;folding;tenstorrent;blackhole;
StartupNotify=true
