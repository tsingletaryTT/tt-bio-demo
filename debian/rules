#!/usr/bin/make -f
# debian/rules -- debhelper build rules for tt-bio-demo.
#
# This is a pure Python + data project (GTK4 UI, a compute-daemon source
# tree, YAML playlist manifests and their input structures): nothing here
# is compiled, so the sequence stays a thin `dh $@` and every later task
# should keep it that way. Anything with a branch in it belongs in
# debian/helpers.sh (Task 3), not inline here -- a `dh` override is glue,
# not logic.
#
# What gets installed is decided in debian/tt-bio-demo.install, which
# names the shipped directories ONE BY ONE rather than globbing the repo
# root -- see that file's header for why, and
# `test_tests_and_scratch_do_not_ship` for what holds the line. The other
# three packages still install nothing of their own: the runtime package
# builds venvs in postinst, the weights package downloads, and the
# metapackage is pure dependencies.

export DH_VERBOSE = 1

# Nothing to compile and no test suite to run as part of the *build*
# (./scripts/test.sh is this project's test entry point and is not wired
# into dpkg-buildpackage); disable both so a bare `dh $@` does not go
# looking for a setup.py/pyproject.toml build system that does not exist.
export DEB_BUILD_OPTIONS = nocheck nostrip

%:
	dh $@

# The .py files ship as application DATA under /opt/tt-bio-demo, not as
# importable system packages, and they are run by the project's own venvs
# (venv-ui and venv-runner) rather than by the system interpreter. So
# there is nothing here for dh_python3 to do: no dist-packages layout to
# generate, and bytecode compiled by the BUILD box's interpreter would be
# wrong on the target anyway. Verified empirically -- building with
# ui/__pycache__ and protocol/__pycache__ populated ships neither.
override_dh_python3:
	# intentionally empty
