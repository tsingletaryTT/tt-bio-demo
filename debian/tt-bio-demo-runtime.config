#!/bin/sh
# Ask, before anything is unpacked, whether to run tt-bio's own system
# installer. A debconf config script is the ONLY correct place for this:
# postinst runs after unpacking and, under a noninteractive frontend, has no
# terminal to ask on -- prompting there would either hang or silently take
# the default without recording it.
set -e

. /usr/share/debconf/confmodule

case "$1" in
    configure|reconfigure)
        # Priority high, not critical: the answer has a safe default and a
        # printed follow-up, so an operator running at a lower priority gets
        # the default (decline) rather than a stalled install.
        db_input high tt-bio-demo-runtime/install-deps || true
        db_go || true
        ;;
esac

#DEBHELPER#
exit 0
