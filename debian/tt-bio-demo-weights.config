#!/bin/sh
# Ask before starting a 3.7 GB download. See tt-bio-demo-runtime.config for
# why the question lives in a config script rather than in postinst.
set -e

. /usr/share/debconf/confmodule

case "$1" in
    configure|reconfigure)
        db_input high tt-bio-demo-weights/download || true
        db_go || true
        ;;
esac

#DEBHELPER#
exit 0
