[Unit]
# The compute daemon, as a supervised `systemd --user` service.
#
# USER, not system (spec: "less display-stack surface to debug at a venue").
# The daemon opens Tenstorrent devices and serves a Unix socket in the user's
# runtime directory; running it as root would put that socket somewhere the
# UI -- which is an ordinary desktop application -- cannot reach without
# extra permission plumbing that has no upside at a conference booth.
Description=tt-bio-demo compute daemon (folds proteins on Tenstorrent hardware)
Documentation=https://github.com/tsingletaryTT/tt-bio-demo
After=graphical-session.target

[Service]
Type=simple

# THE WEIGHTS CACHE PIN LIVES IN THE LAUNCHER SCRIPT NOW, NOT HERE.
#
# This used to be a static `Environment=TT_BIO_CACHE=/opt/tt-bio-demo/weights`
# line. That pinned the postinst's fixed path correctly (see docs/
# followups.md's "root's postinst-time HOME vs desktop-user's
# systemd-service-time HOME" entry, FIXED, for why a fixed path is needed at
# all), but a static `Environment=` line ALWAYS wins over anything the user
# manager's own environment would otherwise supply -- there is no way to
# spell "only if the operator hasn't already set this" in unit-file syntax --
# and it outranks $BOLTZ_CACHE in tt-bio's own resolution order too. So an
# operator who had set $BOLTZ_CACHE (e.g. to relocate the cache to a bigger
# disk) before running `dpkg-reconfigure` got a postinst that correctly
# honoured it and a daemon that ALWAYS loaded from the packaged default
# instead, silently, on every start. See docs/followups.md's "the systemd
# unit's Environment= is unconditional" entry (FIXED).
#
# `scripts/tt-bio-demo-daemon-launcher.sh` is what ExecStart= actually runs.
# It sources scripts/weights-cache.sh and calls the SAME GUARDED
# `tt_bio_demo_weights_cache_packaged` the postinst and scripts/doctor.sh
# call -- which only pins $TT_BIO_CACHE when NEITHER it nor $BOLTZ_CACHE is
# already set -- so an operator's override, however it reaches this
# service's environment (a `~/.config/environment.d/*.conf` generator,
# `systemctl --user set-environment`, or editing this unit directly with
# `systemctl --user edit tt-bio-demo`), is honoured rather than overwritten.
# `test_the_launcher_calls_the_same_guarded_resolver_the_postinst_does` in
# tests/unit/test_packaging.py is what would catch this drifting from the
# postinst's own pin again.
#
# venv-runner's interpreter, ALWAYS, inside the launcher -- not a bare
# `python3` here, which would import neither venv-ui's GTK stack nor
# venv-runner's torch/ttnn one.
ExecStart=/opt/tt-bio-demo/scripts/tt-bio-demo-daemon-launcher.sh %t/tt-bio-demo/runner.sock %t/tt-bio-demo/logs
WorkingDirectory=/opt/tt-bio-demo

# --log-root IS NOT OPTIONAL, and this unit is the one place it cannot be
# forgotten. tt-metal writes its Inspector/Watcher output RELATIVE TO THE
# WORKING DIRECTORY, and a service has no obvious CWD. This project measured
# tt-metal writing 13-14 MB/s into a file it had already unlinked -- invisible
# to a directory walk, and enough to exhaust a tmpfs in about 31 minutes.
# %t is the user's runtime directory, which systemd creates and cleans.
RuntimeDirectory=tt-bio-demo
RuntimeDirectoryPreserve=no

# The booth runs unattended all day: a dead daemon must come back by itself.
# `on-failure` rather than `always` so that a clean operator shutdown
# (`systemctl --user stop`) stays stopped.
Restart=on-failure
RestartSec=5

# A wedged card can make a fold hang; give the daemon time to release its
# devices on stop before SIGKILL, because a killed process holding a chip is
# the state that needs a reboot to clear.
TimeoutStopSec=90
KillSignal=SIGTERM

[Install]
WantedBy=default.target
